<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> · CampusConnect</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/real-auth.css"><script src="/js/auth.js" defer></script>
</head><body><div id="motionProgress"><span></span></div><section class="login-screen auth-screen">
  <%- include('partials/auth-visual') %>
  <div class="login-form-side"><form class="login-form auth-form" id="forgotForm" data-endpoint="/api/auth/forgot-password">
    <div class="mobile-login-brand"><span class="brand-mark">C</span><strong>CampusConnect</strong></div>
    <span class="eyebrow">ACCOUNT RECOVERY</span><h2>Reset your password</h2><p class="muted login-subtitle">Enter the email linked to your account. We'll send reset instructions if the account exists.</p>
    <label for="forgotEmail">Student email address</label><input class="field login-input" id="forgotEmail" name="email" type="email" autocomplete="email" placeholder="you@college.edu" required maxlength="254">
    <button type="submit" class="primary-btn login-submit"><span class="btn-label">Send reset link</span><span>→</span></button><p class="login-error form-message" id="forgotMessage" aria-live="polite"></p>
    <a class="secondary-auth-btn" href="/login">← Back to sign in</a><p class="login-privacy">Reset links expire after 30 minutes.</p>
  </form></div>
</section></body></html>
