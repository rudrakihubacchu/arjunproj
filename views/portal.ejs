<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f6f5ff"><meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="description" content="CampusConnect student portal — campus notices, classes, learning resources, events and support.">
  <title><%= title %> · CampusConnect</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/real-app.css"><script src="/js/portal.js" defer></script>
</head><body data-page="<%= pageKey %>">
  <div id="motionProgress"><span></span></div>
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="/overview"><span class="brand-mark">C</span><span>Campus<span class="brand-light">Connect</span><small>STUDENT PORTAL</small></span></a>
      <div class="student-mini"><div class="avatar"><%= user.name.split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase() %></div><div class="mini-text"><strong><%= user.name %></strong><small><%= user.course %></small></div></div>
      <p class="nav-label">WORKSPACE</p>
      <nav class="nav" aria-label="Main navigation">
        <a class="nav-link <%= pageKey==='overview'?'active':'' %>" href="/overview"><span>◫</span> Overview</a>
        <a class="nav-link <%= pageKey==='notices'?'active':'' %>" href="/notices"><span>▤</span> Notices <i class="nav-dot"></i></a>
        <a class="nav-link <%= pageKey==='timetable'?'active':'' %>" href="/timetable"><span>▦</span> Timetable</a>
        <a class="nav-link <%= pageKey==='materials'?'active':'' %>" href="/materials"><span>▣</span> Study materials</a>
        <a class="nav-link <%= pageKey==='events'?'active':'' %>" href="/events"><span>✦</span> Events</a>
        <a class="nav-link <%= pageKey==='feedback'?'active':'' %>" href="/feedback"><span>✉</span> Feedback</a>
      </nav>
      <div class="sidebar-bottom"><div class="help-card"><div class="help-icon">?</div><strong>Need help?</strong><p>Send your question to the student support team.</p><a href="/feedback">Contact support →</a></div><div class="sidebar-foot">CampusConnect v1.0<br>Student workspace</div></div>
    </aside>
    <main class="main">
      <header class="topbar">
        <button class="menu-btn" id="menuBtn" aria-label="Toggle menu" aria-expanded="false">☰</button>
        <div class="crumb">Student Portal <span>/</span> <strong id="pageCrumb"><%= title %></strong></div>
        <div class="top-actions">
          <label class="search"><span>⌕</span><input id="globalSearch" type="search" placeholder="Search portal..." aria-label="Search portal"></label>
          <a class="icon-btn notification-link" href="/notices" title="Notifications" aria-label="Notifications">♧<b></b></a>
          <button class="logout-btn" id="logoutBtn" type="button">↪ <span>Sign out</span></button>
          <a class="profile-button" href="/profile" aria-label="Open profile"><span class="avatar small"><%= user.name.split(/\s+/).map(w=>w[0]).slice(0,2).join('').toUpperCase() %></span><span><strong><%= user.name %></strong><small>Student</small></span><span>⌄</span></a>
        </div>
      </header>
      <div class="content">
        <% if (pageKey === 'overview') { %>
          <section class="page-section page-enter">
            <div class="welcome-row"><div><p class="eyebrow" id="todayLabel">YOUR CAMPUS AT A GLANCE</p><h1>Good day, <span id="welcomeName"><%= user.name.split(/\s+/)[0] %></span> <span class="wave">✦</span></h1><p class="muted">Here's what's happening with your college today.</p></div><a class="primary-btn" href="/profile">＋ Update profile</a></div>
            <div class="hero-banner"><div class="hero-copy"><span class="hero-tag">CAMPUS ANNOUNCEMENT</span><h2>Your next chapter<br>starts <em>right here.</em></h2><p>Stay informed, stay organised, and make the most of every opportunity on campus.</p><a href="/notices" class="hero-link">Explore announcements <span>↗</span></a></div><div class="hero-art"><div class="orb orb1"></div><div class="orb orb2"></div><div class="art-card"><span>✦</span><strong>Learn.</strong><strong>Grow.</strong><strong>Achieve.</strong><small>YOUR JOURNEY</small></div><div class="art-spark">✳</div></div></div>
            <div class="section-heading"><div><h2>Your overview</h2><p class="muted">A quick look at your student workspace.</p></div><span class="date-pill" id="datePill">Current semester</span></div>
            <div class="stats-grid">
              <article class="stat-card"><div class="stat-top"><span class="stat-icon lavender">▦</span><span class="stat-note">Academic</span></div><p>Attendance</p><div class="stat-value">—<span>%</span></div><small>Connect your college attendance system</small></article>
              <article class="stat-card"><div class="stat-top"><span class="stat-icon mint">▣</span><span class="stat-note">Resources</span></div><p>Study materials</p><div class="stat-value"><%= String(materials.length).padStart(2,'0') %></div><small class="good">Learning links available</small></article>
              <article class="stat-card"><div class="stat-top"><span class="stat-icon peach">▤</span><span class="stat-note">Updates</span></div><p>Active notices</p><div class="stat-value"><%= String(notices.length).padStart(2,'0') %></div><small>Review campus updates</small></article>
              <article class="stat-card"><div class="stat-top"><span class="stat-icon blue">✦</span><span class="stat-note">Campus life</span></div><p>Upcoming events</p><div class="stat-value"><%= String(events.length).padStart(2,'0') %></div><small>Get involved on campus</small></article>
            </div>
            <div class="dashboard-grid">
              <section class="panel schedule-panel"><div class="panel-heading"><div><h2>Today's timetable</h2><p class="muted">Planned learning sessions</p></div><a href="/timetable" class="text-link">Full timetable ↗</a></div><div class="class-list" id="todayClasses"><% classes.forEach(c=>{ %><div class="class-item"><div class="class-time"><%= c.time %></div><div class="class-bar <%= c.color %>"></div><div class="class-info"><strong><%= c.name %></strong><small><%= c.teacher %></small></div><span class="class-room"><%= c.room %></span></div><% }) %></div><p class="form-hint">Starter timetable — confirm times with your college.</p></section>
              <section class="panel notice-panel"><div class="panel-heading"><div><h2>Latest notices</h2><p class="muted">Keep up with campus updates</p></div><a href="/notices" class="text-link">View all ↗</a></div><div class="notice-list"><% notices.slice(0,3).forEach(n=>{ %><article class="notice-item"><div class="notice-symbol <%= n.color %>"><%= n.icon %></div><div class="notice-body"><strong><%= n.title %></strong><p><%= n.text %></p><div class="notice-meta"><span class="tag <%= n.category %>"><%= n.category %></span><span><%= n.date %></span></div></div></article><% }) %></div></section>
            </div>
            <section class="panel quick-panel"><div class="panel-heading"><div><h2>Quick access</h2><p class="muted">Your most-used student services</p></div></div><div class="quick-grid"><a href="/materials" class="quick-item"><span class="quick-icon lavender">▣</span><span><strong>Study materials</strong><small>Notes & resources</small></span><span class="arrow">↗</span></a><a href="/timetable" class="quick-item"><span class="quick-icon mint">▦</span><span><strong>Class timetable</strong><small>Schedule & subjects</small></span><span class="arrow">↗</span></a><a href="/events" class="quick-item"><span class="quick-icon peach">✦</span><span><strong>Campus events</strong><small>Activities & workshops</small></span><span class="arrow">↗</span></a><a href="/feedback" class="quick-item"><span class="quick-icon blue">✉</span><span><strong>Help & feedback</strong><small>Share a suggestion</small></span><span class="arrow">↗</span></a></div></section>
          </section>
        <% } else if (pageKey === 'notices') { %>
          <section class="page-section page-enter"><div class="page-title-row"><div><p class="eyebrow"><%= pageInfo.eyebrow %></p><h1><%= pageInfo.title %></h1><p class="muted">Announcements, academic reminders, and campus opportunities.</p></div><span class="date-pill"><%= notices.length %> updates</span></div>
          <div class="filter-row"><input id="noticeFilter" class="field search-field" placeholder="Filter notices by title or category..." aria-label="Search notices"><select id="noticeCategory" class="field" aria-label="Filter category"><option value="all">All categories</option><option>Academic</option><option>Examination</option><option>Events</option><option>Placement</option></select></div>
          <div id="allNotices" class="notice-cards"><% notices.forEach(n=>{ %><article class="notice-card" data-category="<%= n.category %>" data-search="<%= (n.title+' '+n.text+' '+n.category).toLowerCase() %>"><div class="notice-card-top"><span class="tag <%= n.category %>"><%= n.category %></span><small><%= n.date %></small></div><h3><%= n.title %></h3><p><%= n.text %></p></article><% }) %></div><p class="muted empty-state hidden" id="noticeEmpty">No notices match your filters.</p><div class="info-banner">These initial notice records are starter content. Replace them with announcements from your institution before production use.</div></section>
        <% } else if (pageKey === 'timetable') { %>
          <section class="page-section page-enter"><div class="page-title-row"><div><p class="eyebrow"><%= pageInfo.eyebrow %></p><h1><%= pageInfo.title %></h1><p class="muted">A weekly view to help you plan classes and practical sessions.</p></div><span class="date-pill">Monday – Friday</span></div>
          <div class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>TIME</th><% dayNames.forEach(day=>{ %><th><%= day.toUpperCase() %></th><% }) %></tr></thead><tbody><% timetable.forEach(row=>{ %><tr><td><%= row[0] %></td><% row.slice(1).forEach((subject,i)=>{ %><td><span class="subject-chip <%= ['', 'green', 'orange', 'blue'][(i+row[0].length)%4] %>"><%= subject %></span></td><% }) %></tr><% }) %></tbody></table></div><p class="table-note">Starter timetable only. Confirm your official schedule with your college before relying on it.</p></div></section>
        <% } else if (pageKey === 'materials') { %>
          <section class="page-section page-enter"><div class="page-title-row"><div><p class="eyebrow"><%= pageInfo.eyebrow %></p><h1><%= pageInfo.title %></h1><p class="muted">Useful reference links for practice and revision.</p></div><span class="date-pill"><%= materials.length %> resources</span></div>
          <div class="filter-row"><input id="materialFilter" class="field search-field" placeholder="Search subject or resource..." aria-label="Search materials"><select id="materialType" class="field" aria-label="Filter by subject"><option value="all">All subjects</option><option value="BCA">BCA</option><option value="Programming">Programming</option><option value="Database">Database</option><option value="Web Development">Web Development</option></select></div>
          <div id="materialsGrid" class="materials-grid"><% materials.forEach(m=>{ %><article class="material-card" data-subject="<%= m.subject %>" data-search="<%= (m.title+' '+m.subject+' '+m.description+' '+m.type).toLowerCase() %>"><div class="file-icon <%= m.color %>"><%= m.icon %></div><span class="eyebrow"><%= m.type %></span><h3><%= m.title %></h3><p><%= m.description %></p><div class="material-meta"><span><%= m.subject %></span><span><%= m.size %></span></div><a class="resource-link" href="<%= m.url %>" target="_blank" rel="noopener noreferrer">Open learning resource ↗</a></article><% }) %></div><p class="muted empty-state hidden" id="materialEmpty">No resources match your filters.</p><div class="info-banner">Resources open on their respective educational websites. Confirm any institutional course notes or PDFs with your department.</div></section>
        <% } else if (pageKey === 'events') { %>
          <section class="page-section page-enter"><div class="page-title-row"><div><p class="eyebrow"><%= pageInfo.eyebrow %></p><h1><%= pageInfo.title %></h1><p class="muted">Explore activities, workshops, and career development opportunities.</p></div><span class="date-pill"><%= events.length %> listed</span></div>
          <div id="eventsGrid" class="events-grid"><% events.forEach(e=>{ const interested=eventInterestIds.includes(e.id); %><article class="event-card"><span class="event-date">▣ <%= e.date %></span><div class="event-type"><%= e.kind %></div><h3><%= e.title %></h3><p><%= e.description %></p><div class="material-meta"><span>⌖ <%= e.place %></span><span>◷ <%= e.time %></span></div><button class="resource-link interest-btn" type="button" data-event-id="<%= e.id %>" <%= interested?'disabled':'' %>><%= interested?'✓ Interest saved':"I'm interested ↗" %></button></article><% }) %></div><div class="info-banner">Event listings are starter content. Marking interest saves your account's selection to the application database.</div></section>
        <% } else if (pageKey === 'feedback') { %>
          <section class="page-section page-enter"><div class="page-title-row"><div><p class="eyebrow"><%= pageInfo.eyebrow %></p><h1><%= pageInfo.title %></h1><p class="muted">Send a message to the portal support team.</p></div></div>
          <div class="feedback-layout"><div class="panel feedback-intro"><div class="feedback-symbol">✉</div><h2>Your voice matters.</h2><p class="muted">Share a suggestion, report a website issue, or ask a general question. Your submissions are saved to the CampusConnect database and associated with your account.</p><div class="contact-line"><span>◷</span><div><strong>Support requests</strong><small><%= feedbackCount %> message(s) submitted by you</small></div></div><div class="contact-line"><span>⌖</span><div><strong>College administration</strong><small>Official contact details should be added by your institution</small></div></div></div>
          <form id="feedbackForm" class="panel feedback-form"><h2>Send a message</h2><label>Reply-to email<input class="field" value="<%= user.email %>" disabled></label><label>Topic<select class="field" id="feedbackTopic" required><option>General enquiry</option><option>Website issue</option><option>Study materials</option><option>Timetable</option><option>Suggestion</option></select></label><label>Your message<textarea class="field" id="feedbackMessage" rows="5" required minlength="5" maxlength="3000" placeholder="Write your message here..."></textarea></label><button class="primary-btn" type="submit">Submit feedback →</button><p class="form-hint" id="feedbackStatus" aria-live="polite"></p></form></div></section>
        <% } else if (pageKey === 'profile') { %>
          <section class="page-section page-enter"><div class="page-title-row"><div><p class="eyebrow"><%= pageInfo.eyebrow %></p><h1><%= pageInfo.title %></h1><p class="muted">Your account details are stored securely in the application database.</p></div></div>
          <div class="profile-grid"><form id="profileForm" class="panel feedback-form"><h2>Personal information</h2><label>Full name<input class="field" id="profileName" value="<%= user.name %>" required minlength="2" maxlength="80"></label><label>Email address<input class="field" value="<%= user.email %>" disabled><span class="form-hint">Email changes are not enabled in this version.</span></label><label>Course and semester<input class="field" id="profileCourse" value="<%= user.course %>" required maxlength="120"></label><label>Account created<input class="field" value="<%= new Date(user.createdAt+'Z').toLocaleDateString() %>" disabled></label><button class="primary-btn" type="submit">Save profile changes →</button><p class="form-hint" id="profileStatus" aria-live="polite"></p></form>
          <form id="passwordForm" class="panel feedback-form"><h2>Change password</h2><p class="muted">Use at least 8 characters, including a letter and a number.</p><label>Current password<input class="field" id="currentPassword" type="password" required autocomplete="current-password"></label><label>New password<input class="field" id="newPassword" type="password" minlength="8" required autocomplete="new-password"></label><label>Confirm new password<input class="field" id="confirmPassword" type="password" minlength="8" required autocomplete="new-password"></label><button class="primary-btn" type="submit">Update password →</button><p class="form-hint" id="passwordStatus" aria-live="polite"></p></form></div></section>
        <% } %>
        <footer class="footer"><span>© <span id="year"></span> CampusConnect Student Portal</span><span>Learn · Connect · Grow</span></footer>
      </div>
    </main>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body></html>
