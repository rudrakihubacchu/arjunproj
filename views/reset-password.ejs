<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> · CampusConnect</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/real-auth.css"><script src="/js/auth.js" defer></script>
</head><body><div id="motionProgress"><span></span></div><section class="login-screen auth-screen">
  <%- include('partials/auth-visual') %>
  <div class="login-form-side"><form class="login-form auth-form" id="resetForm" data-endpoint="/api/auth/reset-password">
    <div class="mobile-login-brand"><span class="brand-mark">C</span><strong>CampusConnect</strong></div>
    <span class="eyebrow">SECURE YOUR ACCOUNT</span><h2>Choose a new password</h2><p class="muted login-subtitle">Create a new password for your CampusConnect account.</p>
    <input type="hidden" name="token" value="<%= token %>">
    <label for="resetPassword">New password</label><div class="password-wrap"><input class="field login-input" id="resetPassword" name="password" type="password" autocomplete="new-password" minlength="8" required placeholder="At least 8 characters"><button type="button" class="password-toggle" data-password-toggle="resetPassword">Show</button></div>
    <label for="resetConfirmPassword">Confirm new password</label><div class="password-wrap"><input class="field login-input" id="resetConfirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required placeholder="Re-enter your password"><button type="button" class="password-toggle" data-password-toggle="resetConfirmPassword">Show</button></div>
    <button type="submit" class="primary-btn login-submit"><span class="btn-label">Update password</span><span>→</span></button><p class="login-error form-message" id="resetMessage" aria-live="polite"></p><a class="secondary-auth-btn" href="/login">← Back to sign in</a>
  </form></div>
</section></body></html>
