<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f6f5ff"><meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="description" content="Create a CampusConnect student account.">
  <title><%= title %> · CampusConnect</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/real-auth.css">
  <script src="/js/auth.js" defer></script>
</head><body>
  <div id="motionProgress"><span></span></div>
  <section class="login-screen auth-screen register-screen">
    <%- include('partials/auth-visual') %>
    <div class="login-form-side"><form class="login-form auth-form" id="registerForm" data-endpoint="/api/auth/register">
      <div class="mobile-login-brand"><span class="brand-mark">C</span><strong>CampusConnect</strong></div>
      <span class="eyebrow">START YOUR JOURNEY</span><h2>Create your account</h2>
      <p class="muted login-subtitle">One secure account for your student workspace.</p>
      <label for="registerName">Full name</label><input class="field login-input" id="registerName" name="name" autocomplete="name" placeholder="Your full name" required minlength="2" maxlength="80">
      <label for="registerEmail">College email address</label><input class="field login-input" id="registerEmail" name="email" type="email" autocomplete="email" placeholder="you@college.edu" required maxlength="254">
      <label for="registerCourse">Course and semester</label><input class="field login-input" id="registerCourse" name="course" placeholder="BCA · Semester 5" value="BCA · Semester 5" required maxlength="120">
      <label for="registerPassword">Create password</label><div class="password-wrap"><input class="field login-input" id="registerPassword" name="password" type="password" autocomplete="new-password" minlength="8" required placeholder="At least 8 characters"><button type="button" class="password-toggle" data-password-toggle="registerPassword">Show</button></div>
      <label for="registerConfirmPassword">Confirm password</label><div class="password-wrap"><input class="field login-input" id="registerConfirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required placeholder="Re-enter your password"><button type="button" class="password-toggle" data-password-toggle="registerConfirmPassword">Show</button></div>
      <p class="password-hint">Use at least 8 characters with a letter and a number.</p>
      <label class="terms-check"><input id="acceptTerms" type="checkbox" required> <span>I understand this account stores my profile and portal submissions.</span></label>
      <button type="submit" class="primary-btn login-submit"><span class="btn-label">Create secure account</span><span>→</span></button>
      <p class="login-error form-message" id="registerMessage" aria-live="polite"></p>
      <div class="auth-divider"><span>ALREADY REGISTERED?</span></div><a class="secondary-auth-btn" href="/login">Sign in to your account <span>↗</span></a>
      <p class="login-privacy">Your password is never stored as plain text.</p>
    </form></div>
  </section>
</body></html>
