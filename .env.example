# Required in production: use a long random secret (32+ random bytes).
SESSION_SECRET=replace-with-a-long-random-secret-before-deployment
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DB_DIR=./data

# Configure SMTP to deliver password reset links by email.
# Without SMTP, reset links are printed in the server terminal for local development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CampusConnect Support <support@example.com>
